{
  "schema_version": 1,
  "name": "goal-conditioned-her-v1-stochastic-v1",
  "dependencies": {
    "gym_longicontrol": "1.0.0",
    "stable_baselines3": "2.9.0",
    "gymnasium": "1.3.0",
    "torch": "2.14.0",
    "numpy": "2.4.6"
  },
  "environment_id": "StochasticTrack-v1",
  "max_episode_steps": 1800,
  "task": {
    "max_time_s": 140.0,
    "max_speed_violation_m_s": 0.0
  },
  "goal_scales": {
    "route_length_m": 1000.0,
    "horizon_s": 180.0,
    "speed_scale_m_s": 37.0
  },
  "track_splits": {
    "development_calibration": [2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008],
    "validation": [3000, 3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008],
    "v1_exploratory_evaluation": [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008],
    "paper_final_test_reserved": [4000, 4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008, 4009, 4010, 4011, 4012, 4013, 4014, 4015, 4016, 4017]
  },
  "training_seeds": [11, 29, 47],
  "checkpoint_steps": [50000, 100000, 150000, 200000, 250000, 300000],
  "development_evaluation_steps": [50000, 100000, 150000, 200000, 250000, 300000],
  "validation_evaluation_steps": [300000],
  "reward": {
    "success_reward": 1.0,
    "otherwise_reward": 0.0,
    "delivery": "first-arrival-transition-only",
    "energy_in_reward": false
  },
  "conditions": [
    {
      "condition_id": "sac-no-her",
      "replay_buffer": "benchmarks.goal_conditioned.replay_buffer.GoalReplayBuffer",
      "hindsight_relabeling": false
    },
    {
      "condition_id": "sac-her",
      "replay_buffer": "benchmarks.goal_conditioned.replay_buffer.GoalReplayBuffer",
      "hindsight_relabeling": true
    }
  ],
  "her": {
    "n_sampled_goal": 4,
    "goal_selection_strategy": "future",
    "relabelled_fields": ["target_position"],
    "fixed_fields": ["deadline", "speed_tolerance"],
    "copy_info_dict": false,
    "recompute_terminal_mask": true
  },
  "sac": {
    "learning_rate": 0.0003,
    "buffer_size": 1000000,
    "learning_starts": 1800,
    "batch_size": 256,
    "tau": 0.005,
    "gamma": 0.99,
    "train_freq": 1,
    "gradient_steps": 1,
    "ent_coef": "auto",
    "policy_network": [256, 256],
    "policy": "MultiInputPolicy",
    "handle_timeout_termination": false
  }
}
